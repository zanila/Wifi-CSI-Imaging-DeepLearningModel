                "--image_dir", "Dataset/640",
                "--T", "64",
                "--window_sec", "1.0",
                "--stride_sec", "0.5",
                "--aggregation", "mean",
                "--imputation", "linear"
            ]
        },
        {
            "name": "Python Debugger: ground_truth_extraction",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--image_dir", "Dataset/640",
                "--output_dir", "Stage1/gt_output",
                "--mask_size", "32",
                "--bbox_padding", "0.1",
                "--confidence_threshold", "0.5"
            ]
        },
        {
